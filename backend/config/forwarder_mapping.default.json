{
  "version": 1,
  "_说明": "货代业务映射：group_logic / unit_conversion / columns_mapping。表头别名见 global_table_column_aliases。",
  "global_table_column_aliases": {
    "shipment_id": ["Shipment ID", "FBA单号", "货件编号"],
    "fba_id": ["FBAID", "FBA ID", "FBA单号", "货件编号"],
    "reference_id": ["Reference ID", "ID号", "Amazon Reference"],
    "po_number": ["POAnumber", "PO号", "PO", "PO Number"],
    "box_range": ["箱号段(起始~结束)", "箱号段(起始-结束)", "箱号段", "箱号范围", "箱序号"],
    "box_count": ["总箱数", "件数", "箱数"],
    "sku": ["SKU"],
    "english_name": ["英文品名", "品名英文", "物品英文名"],
    "chinese_name": ["中文品名", "品名中文", "物品中文名"],
    "brand": ["Brand品牌", "Brand", "品牌"],
    "material": ["材质", "材料", "材质/用途", "Material&Use", "材质(中文)"],
    "purpose": ["用途", "用途(中文)"],
    "hs_code": ["清关编码", "海关编码", "HS Code", "HS编码"],
    "asin": ["ASIN/销售链接", "ASIN", "销售链接"],
    "battery": ["是否带电", "Battery", "带电"],
    "magnet": ["是否带磁", "Magnet", "带磁"],
    "model": ["型号"],
    "total_qty": ["总数量", "个数", "商品数量", "总商品数"],
    "qty_per_box": ["单箱内数量", "每箱数量", "箱内数量"],
    "unit": ["单位"],
    "pcs_per_set": ["每套个数"],
    "purchase_price": ["采购单价(RMB)", "采购单价"],
    "declared_price": ["申报单价", "单个货值", "货值", "申报单价/USD", "申报单价(USD)", "申报单价 (USD)"],
    "total_declared_value_usd": ["总申报金额/USD", "总申报金额", "申报总价"],
    "unit_weight_kg": ["实际单件重/kg", "单件重量/kg", "单件毛重/kg", "单件实重", "单件重量", "单件变量"],
    "sku_image": ["SKU图片"],
    "shipping_mark": ["唛头"],
    "box_weight": ["单箱重量", "单箱毛重", "包装箱重量"],
    "length": ["长", "长(cm)", "单件长"],
    "width": ["宽", "宽(cm)", "单件宽"],
    "height": ["高", "高(cm)", "单件高"]
  },
  "forwarders": {
    "qiluo": {
      "name": "琪珞国际",
      "template_file": "qiluo.xlsx",
      "group_logic": "GROUP_BY_BOX_RANGE",
      "unit_conversion": { "weight": "kg", "dimension": "cm" },
      "separate_material_purpose": false,
      "columns_mapping": {
        "fba_id": { "source": "shipment", "field": "shipment_id" },
        "po_number": { "source": "workflow", "field": "po_number" },
        "box_range": { "source": "computed", "field": "box_range" },
        "box_count": { "source": "computed", "field": "box_count" },
        "sku": { "source": "shipment", "field": "sku" },
        "english_name": { "source": "priority", "field": "english_name" },
        "chinese_name": { "source": "master_db", "field": "chinese_name" },
        "qty_per_box": { "source": "priority", "field": "qty_per_box" },
        "declared_price": { "source": "master_db", "field": "declared_price" },
        "material": { "source": "master_db", "field": "material" },
        "purpose": { "source": "master_db", "field": "purpose" },
        "brand": { "source": "master_db", "field": "brand" },
        "model": { "source": "priority", "field": "model" },
        "hs_code": { "source": "master_db", "field": "hs_code" },
        "unit_weight_kg": { "source": "priority", "field": "unit_weight_kg" },
        "length": { "source": "priority", "field": "length" },
        "width": { "source": "priority", "field": "width" },
        "height": { "source": "priority", "field": "height" }
      }
    }
  }
}
