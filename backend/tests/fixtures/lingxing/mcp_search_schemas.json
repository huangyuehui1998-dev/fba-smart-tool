  "get_multi_platform_shop_list": {
   "toolId": "get_multi_platform_shop_list",
   "displayName": "查询多平台店铺列表",
   "toolType": "read",
   "inputSchema": {
    "type": "object",
    "properties": {
     "store_id": {
      "description": "店铺ID数组，用于筛选指定店铺",
      "type": "array"
     },
     "amazon_store_id": {
      "description": "亚马逊店铺ID数组，用于筛选指定亚马逊店铺",
      "type": "array"
     },
     "platform_code": {
      "description": "数据量较大，建议先通过platform_code参数筛选特定平台，避免全量返回被截断。平台CODE数组，用于筛选指定平台的店铺。平台CODE枚举: 10001=Amazon, 10002=Shopify, 10003=eBay, 10004=Wish, 10005=AliExpress, 10006=Shopee, 10007=Lazada, 10008=Walmart, 10009=Custom, 10010=Wayfair, 10011=TikTok, 10012=MercadoLibre, 10013=Cdiscount, 10014=NewEgg, 10015=Rakuten, 10016=Shopline, 10017=Teapplix, 10018=Shoplazza, 10019=Ueeshop, 10020=Coupang, 10021=SHEIN平台模式, 10022=Temu, 10024=Temu半托管, 10025=Otto, 10026=Ozon, 10027=SHEIN代运营, 10028=SHEIN半托管, 10029=AliExpress半托管, 10030=AliExpress全托管, 10031=AliExpress海外托管, 10032=Tiktok全托管, 10033=Qoo10, 10034=Mirakl, 10035=Amazon VC, 10036=Kaufland, 10037=Allegro, 10038=Line, 10039=SPS, 10041=阿里国际站, 10042=SPOTTER。注意：若用户提及的平台不在上述列表中，可先不传platform_code调用本接口获取全量数据后从返回的platform_code/platform_name中确认实际编码。",
      "type": "array"
     }
    }
   }
  },
